win.title: /nvim/
-
save and quit: user.nvim_command("wqa")
save an exit: user.nvim_command("wqa")
save: user.nvim_command("w")
quit: user.nvim_command("q")
force quit: user.nvim_command("q!")
flash: user.nvim_prefix("s")
tree flash: user.nvim_prefix("S")
new file: user.nvim_prefix(":new ")
new file vert: user.nvim_prefix(":vnew ")
vertical split: user.nvim_command("vs")
buffer previous: user.nvim_command("bp")
buffer next: user.nvim_command("bn")
half Down: key("ctrl-d")
half Up: key("ctrl-u")
page down: key("ctrl-f")
page up: key("ctrl-b")
go top: user.key("gg")
got bottom user.key("G")
all down that: user.key("u")

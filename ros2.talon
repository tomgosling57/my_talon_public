-
ross driver start: 
    user.execute_terminal_command('echo "Suggested sequence: hardware, sensors, map, nav"')
    insert("~/ros_driver_start.sh ")
ross driver start hardware: user.execute_terminal_command("~/ros_driver_start.sh hardware")
ross start sequence: insert("hardware, sensors, map, nav")
ross driver stop: insert("~/ros_driver_stop.sh all")
fox glove start: insert("~/aiil_workspace/bin/webui.py -s")
fox glove stop: insert("~/aiil_workspace/bin/webui.py -t")
ross log all: user.execute_terminal_command("docker logs microros")
ross log bot: user.execute_terminal_command("docker logs -f rosbot")
ross stop all software: 
    user.execute_terminal_command("~/ros_driver_stop.sh all")
    user.execute_terminal_command("~/aiil_workspace/bin/webui.py -t")
ross teleop: insert("ros2 run teleop_twist_keyboard teleop_twist_keyboard ")
ross teleop stamped: insert("ros2 run teleop_twist_keyboard teleop_twist_keyboard --ros-args -p stamped:=true")
robot logs: user.execute_terminal_command("docker logs -f rosbot")
ross python package: user.dump("ros2 pkg create --build-type ament_python x --dependencies rclpy ")
ross see package: insert("ros2 pkg create --build-type ament_cmake ")
ross run: insert("ros2 run ")
ross launch: insert("ros2 launch ")
ross build: insert("colcon build ")
ross build selected: insert("colcon build --packages-select ")
ross install: insert("rosdep install --from-paths src --rosdistro jazzy -y")
ross setup: insert("source install/setup.bash")
ross set domain: insert("set_ros_domain ")

ross jet visualize: user.execute_terminal_command("rviz2 -d ~/aiil_workspace/humble_workspace/src/aiil_rosbot_demo/rviz/gazebo.rviz")
ross jet empty world: user.execute_terminal_command("ros2 launch rosbot_gazebo simulation.yaml robot_model:=rosbot rviz:=False gz_world:=/home/user/aiil_workspace/humble_workspace/src/husarion/husarion_office_gz/worlds/empty_with_plugins.sdf")
ross jet husarion world: user.execute_terminal_command("ros2 launch rosbot_gazebo simulation.yaml robot_model:=rosbot rviz:=False")
ross jet maze: user.execute_terminal_command("ros2 launch rosbot_gazebo simulation.yaml robot_model:=rosbot rviz:=False gz_world:=/home/user/aiil_workspace/humble_workspace/src/aiil_gazebo/worlds/maze.sdf")
ross jet hazard maze: user.execute_terminal_command("ros2 launch rosbot_gazebo simulation.yaml robot_model:=rosbot rviz:=False gz_world:=/home/user/aiil_workspace/humble_workspace/src/aiil_gazebo/worlds/hazards.sdf")
ross connect ethernet: user.execute_terminal_command("ssh husarion@169.254.1.1")

ross copy workspace: insert("scp -r ~/aiil_workspace/humble_workspace/src/par_coursework/g30  husarion@169.254.1.1:~/aiil_workspace/humble_workspace/src/par_coursework/")
ross build assignment:
  user.execute_terminal_command("source install/setup.bash")
  user.execute_terminal_command("colcon build --packages-select snc snc_interfaces")
  user.execute_terminal_command("source install/setup.bash")


robot IP universe: insert("192.168.100.175")

test path tracer: insert("ros2 run snc path_tracing_node --ros-args -p testing_mode:=true")
ros launch assignment: insert("ros2 launch snc snc.launch.py")
ross launch assignment test mode: insert("ros2 launch snc snc.launch.py testing_mode:=true")
ross launch find object: insert("ros2 launch snc find_object.launch.py")

ross launch humble assignment test mode: insert("ros2 launch snc rosbot2.launch.py testing_mode:=true")
ross publish trigger start: insert("ros2 topic pub --once /trigger_start std_msgs/msg/Empty \"{}\"")
ross publish challenge start: insert("ros2 topic pub --once /snc_start std_msgs/msg/Empty \"{}\"")
ross publish go home: user.execute_terminal_command("ros2 topic pub --once /go_home std_msgs/msg/Empty \"{}\"")
ross publish trigger home: user.execute_terminal_command("ros2 topic pub --once /trigger_home std_msgs/msg/Empty \"{}\"")
ross publish trigger teleop: user.execute_terminal_command("ros2 topic pub --once /trigger_teleop std_msgs/msg/Empty \"{}\"")
ross exploration start: user.execute_terminal_command("ros2 service call /snc_exploration_control snc_interfaces/srv/ExplorationControl \"{command: 'START'}\"")
ross exploration stop: user.execute_terminal_command("ros2 service call /snc_exploration_control snc_interfaces/srv/ExplorationControl \"{command: 'STOP'}\"")
ross start workspace: user.execute_terminal_command("cd ~/aiil_workspace/humble_workspace/src/par_coursework/g30 && ./start_workspace.sh")
ross go assignment directory: user.execute_terminal_command("cd ~/aiil_workspace/humble_workspace/src/par_coursework/g30")
ross topic list: user.execute_terminal_command("ros2 topic list")
ross service list: user.execute_terminal_command("ros2 service list")
ross node list: user.execute_terminal_command("ros2 node list") 
ross build sim link: user.execute_terminal_command("colcon build --symlink-install")
ross bring up slam: user.execute_terminal_command("ros2 launch aiil_gazebo slam.launch.py")
ross bring up nav: user.execute_terminal_command("ros2 launch aiil_gazebo nav_bringup.launch.py")
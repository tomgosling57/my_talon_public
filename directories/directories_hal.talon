os: linux
-   
open talon: user.execute_terminal_command("cd ~/.talon/user")
talon user directory: insert("~/.talon/user/")
community directory: insert("~/.talon/user/community/")
open my talon:user.execute_terminal_command("cd ~/.talon/user/my_talon")
my talon directory: insert("~/.talon/user/my_talon/")
open AI: user.execute_terminal_command("cd ~/projects/rmit/ai25/")
AI directory: insert("~/projects/rmit/ai25/")
open model: user.execute_terminal_command("cd ~/.talon/user/talon-ai-tools/GPT/")
talon model directory: insert("cd ~/.talon/user/talon-ai-tools/GPT/")
cleanit directory: insert("~/projects/cleanit/")
orange grove directory: insert("~/projects/orange-grove/")
trains directory: insert("~/projects/n3v/")
music directory: insert("~/Music/")
downloads directory: insert("~/Downloads/")
documents directory: insert("~/Documents/")
apps directory: insert("~/apps/")
projects directory: insert("~/projects/")
shell directory: insert("~/projects/shell/")
bin directory: insert("/bin/")
media directory: insert("/media/tomg/")
vm config directory: insert("~/.config/nvim/")
vim plugins directory: insert("~/.config/nvim/lua/plugins/")
plugins directory: mimic("vim plugins directory")
humble directory: insert("~/aiil_workspace/humble_workspace/")
humble source directory: insert("~/aiil_workspace/humble_workspace/src/")
par assignment directory: insert("~/aiil_workspace/humble_workspace/src/as2")
robot assignment directory: insert("~/aiil_workspace/humble_workspace/src/par_coursework/par-ass2/")



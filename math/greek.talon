tag: user.math  
-
# Capital Greek Letters
capital alpha: insert("Α")
capital beta: insert("Β")
capital gamma: insert("Γ")
capital delta: insert("Δ")
capital epsilon: insert("Ε")
capital zeta: insert("Ζ")
 capital eta: insert("Η")
capital theta: insert("Θ")
capital iota: insert("Ι")
capital kappa: insert("Κ")
capital lambda: insert("Λ")
capital mu: insert("Μ")
capital nu: insert("Ν")
capital xi: insert("Ξ")
capital omicron: insert("Ο")
capital pi: insert("Π")
capital rho: insert("Ρ")
capital sigma: insert("Σ")
capital tau: insert("Τ")
capital upsilon: insert("Υ")
capital fi fi: insert("Φ")
capital chi: insert("Χ")
capital psi: insert("Ψ")
capital omega: insert("Ω")

# Lowercase Greek Letters
alpha: insert("α")
beta: insert("β")
gamma: insert("γ")
delta: insert("δ")
epsilon: insert("ε")
zeta: insert("ζ")
eta: insert("η")
theta: insert("θ")
iota: insert("ι")
kappa: insert("κ")
lambda: insert("λ")
mu: insert("μ")
nu: insert("ν")
xi: insert("ξ")
omicron: insert("ο")
pi: insert("π")
rho: insert("ρ")
sigma: insert("σ")
final sigma: insert("ς")
tau: insert("τ")
upsilon: insert("υ")
fi fi: insert("φ")
chi: insert("χ")
psi: insert("ψ")
omega: insert("ω")
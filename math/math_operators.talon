tag: user.math
-
# Basic Arithmetic
plus: insert("+")
minus: insert("-")
times: insert("×")
divide: insert("÷")
equals: insert("=")
not equals: insert("≠")
plus or minus: insert("±")

# Comparison Operators
less than: insert("<")
greater than: insert(">")
less than or equal: insert("≤")
greater than or equal: insert("≥")

# Superscript Numbers
superscript zero: insert("⁰")
superscript one: insert("¹")
superscript two: insert("²")
squared: insert("²")
superscript three: insert("³")
cubed: insert("³")
superscript four: insert("⁴")
superscript five: insert("⁵")
superscript six: insert("⁶")
superscript seven: insert("⁷")
superscript eight: insert("⁸")
superscript nine: insert("⁹")

# Subscript Numbers
subscript zero: insert("₀")
subscript one: insert("₁")
subscript two: insert("₂")
subscript three: insert("₃")
subscript four: insert("₄")
subscript five: insert("₅")
subscript six: insert("₆")
subscript seven: insert("₇")
subscript eight: insert("₈")
subscript nine: insert("₉")

# Fractions
fraction one half: insert("½")
fraction one quarter: insert("¼")
fraction three quarters: insert("¾")

# Other Math Symbols
infinity: insert("∞")
empty set: insert("∅")
angle: insert("∠")
square root: insert("√")
integral: insert("∫")
sum: insert("∑")
product: insert("∏")
partial derivative: insert("∂")
gradient: insert("∇")
there exists: insert("∃")
for all: insert("∀")
element of: insert("∈")
not element of: insert("∉")
subset of: insert("⊂")
subset or equal: insert("⊆")
not subset of: insert("⊄")
superset of: insert("⊃")
superset or equal: insert("⊇")
not superset of: insert("⊅")
union: insert("∪")
intersection: insert("∩")
logical and: insert("∧")
logical or: insert("∨")
not: insert("¬")
implies: insert("⇒")
if and only if: insert("⇔")
therefore: insert("∴")
because: insert("∵")
proportional to: insert("∝")
approximately equal: insert("≈")
identical to: insert("≡")
not identical to: insert("≢")
much less than: insert("≪")
much greater than: insert("≫")

# Subscript Letters
subscript air: insert("ₐ")
subscript bat: insert("♭")
subscript cap: insert("ꜝ")
subscript drum: insert("ᑯ")
subscript each: insert("ₑ")
subscript fine: insert("բ")
subscript gust: insert("ց")
subscript hash: insert("ₕ")
subscript sit: insert("ᵢ")
subscript jury: insert("ⱼ")
subscript crunch: insert("ₖ")
subscript look: insert("ₗ")
subscript made: insert("ₘ")
subscript near: insert("ₙ")
subscript odd: insert("ₒ")
subscript pit: insert("ₚ")
subscript quench: insert("૧")
subscript red: insert("ᵣ")
subscript sun: insert("ₛ")
subscript trap: insert("ₜ")
subscript urge: insert("ᵤ")
subscript vest: insert("ᵥ")
subscript whale: insert("w")
subscript box: insert("ₓ")
subscript yank: insert("ᵧ")
subscript zip: insert("₂")

# Superscript Letters
superscript air: insert("ᵃ")
superscript bat: insert("ᵇ")
superscript cap: insert("ᶜ")
superscript drum: insert("ᵈ")
superscript each: insert("ᵉ")
superscript fine: insert("ᶠ")
superscript gust: insert("ᵍ")
superscript hash: insert("ʰ")
superscript sit: insert("ⁱ")
superscript jury: insert("ʲ")
superscript crunch: insert("ᵏ")
superscript look: insert("ˡ")
superscript made: insert("ᵐ")
superscript near: insert("ⁿ")
superscript odd: insert("ᵒ")
superscript pit: insert("ᵖ")
superscript quench: insert("۹")
superscript red: insert("ʳ")
superscript sun: insert("ˢ")
superscript trap: insert("ᵗ")
superscript urge: insert("ᵘ")
superscript vest: insert("ᵛ")
superscript whale: insert("ʷ")
superscript box: insert("ˣ")
superscript yank: insert("ʸ")
superscript zip: insert("ᶻ")

# Subscript and Superscript Infinity
subscript infinity: insert("∞") # Unicode does not have a dedicated subscript infinity character, using regular infinity
superscript infinity: insert("∞") # Unicode does not have a dedicated superscript infinity character, using regular infinity

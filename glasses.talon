os: windows
-
glasses recenter: key("ctrl-shift-alt-r")
glasses calibrate: key("ctrl-shift-alt-c")
glasses panoramic: key("ctrl-shift-alt-0")
glasses single: key("ctrl-shift-alt-1")
glasses double: key("ctrl-shift-alt-2")
glasses double extended: key("ctrl-shift-alt-5")
glasses push: key("ctrl-shift-alt-down")
glasses pull: key("ctrl-shift-alt-up")
open spacewalker: key("ctrl-shift-alt-s")